{
  "name": "@responsive-image/vite-plugin",
  "version": "3.0.1",
  "description": "Vite plugins to process and resize responsive images",
  "repository": "github:simonihmig/responsive-image",
  "license": "MIT",
  "author": "Simon Ihmig <simon.ihmig@gmail.com>",
  "files": [
    "dist",
    "client.d.ts"
  ],
  "type": "module",
  "keywords": [
    "responsive image",
    "responsive images",
    "vite-plugin",
    "vite plugin",
    "vite"
  ],
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "import": {
        "types": "./client.d.ts"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:fix": "concurrently 'npm:lint.*:fix' --names 'fix:'",
    "lint.eslint": "eslint .",
    "lint.eslint:fix": "eslint . --fix",
    "lint.publint": "publint",
    "lint.prettier": "prettier . --check",
    "lint.prettier:fix": "prettier . --write",
    "lint.types": "tsc --noEmit",
    "prepack": "pnpm turbo build",
    "start": "tsdown --watch",
    "test.vitest": "vitest run",
    "test.vitest:watch": "vitest watch"
  },
  "dependencies": {
    "@responsive-image/build-utils": "workspace:^",
    "@responsive-image/core": "workspace:^",
    "blurhash": "^2.0.4",
    "imagetools-core": "^10.0.0",
    "sharp": "^0.35.0",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@responsive-image/internals": "workspace:*",
    "@tsconfig/node22": "22.0.7",
    "@types/jest-image-snapshot": "6.4.2",
    "@types/node": "22.20.7",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "glob": "14.0.6",
    "jest-image-snapshot": "6.5.2",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "compatiblePackages": {
    "schemaVersion": 1,
    "rolldown": {
      "type": "incompatible",
      "reason": "Uses Vite-specific APIs"
    },
    "rollup": {
      "type": "incompatible",
      "reason": "Uses Vite-specific APIs"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "22.* || >= 24"
  }
}
