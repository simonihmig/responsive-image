{
  "name": "@responsive-image/internals",
  "version": "0.0.0",
  "description": "Internal tooling",
  "repository": "github:simonihmig/responsive-image",
  "license": "MIT",
  "author": "Simon Ihmig <simon.ihmig@gmail.com>",
  "private": "true",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint:fix": "concurrently 'npm:lint.*:fix' --names 'fix:'",
    "lint.eslint": "eslint . --cache",
    "lint.eslint:fix": "eslint . --fix",
    "lint.publint": "publint",
    "lint.prettier": "prettier --check .",
    "lint.prettier:fix": "prettier --write .",
    "prepack": "pnpm turbo build"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./eslint": "./dist/eslint.js",
    "./playwright": "./dist/playwright.js",
    "./screenshots": "./src/playwright/__screenshots__/index.js"
  },
  "dependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.6.0",
    "globals": "17.14.0",
    "typescript-eslint": "8.74.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "26.6.10",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@playwright/test": "^1.52.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "engines": {
    "node": "22.* || >= 24"
  }
}
