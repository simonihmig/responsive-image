{
  "name": "@responsive-image/webpack",
  "version": "3.0.1",
  "description": "Webpack loaders to process and resize responsive images",
  "keywords": [
    "responsive image",
    "responsive images",
    "webpack"
  ],
  "repository": "github:simonihmig/responsive-image",
  "license": "MIT",
  "author": "Simon Ihmig <simon.ihmig@gmail.com>",
  "files": [
    "dist",
    "client.d.ts"
  ],
  "type": "module",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./export": {
      "import": "./dist/export.mjs",
      "require": "./dist/export.cjs"
    },
    "./loader": {
      "import": "./dist/loader.mjs",
      "require": "./dist/loader.cjs"
    },
    "./lqip/blurhash": {
      "import": "./dist/lqip/blurhash.mjs",
      "require": "./dist/lqip/blurhash.cjs"
    },
    "./lqip/color": {
      "import": "./dist/lqip/color.mjs",
      "require": "./dist/lqip/color.cjs"
    },
    "./lqip/color-css": {
      "import": "./dist/lqip/color-css.mjs",
      "require": "./dist/lqip/color-css.cjs"
    },
    "./lqip/inline": {
      "import": "./dist/lqip/inline.mjs",
      "require": "./dist/lqip/inline.cjs"
    },
    "./lqip/inline-css": {
      "import": "./dist/lqip/inline-css.mjs",
      "require": "./dist/lqip/inline-css.cjs"
    },
    "./lqip/thumbhash": {
      "import": "./dist/lqip/thumbhash.mjs",
      "require": "./dist/lqip/thumbhash.cjs"
    },
    "./resize": {
      "import": "./dist/resize.mjs",
      "require": "./dist/resize.cjs"
    },
    "./client": {
      "import": {
        "types": "./client.d.ts"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:fix": "concurrently 'npm:lint.*:fix' --names 'fix:'",
    "lint.eslint": "eslint .",
    "lint.eslint:fix": "eslint . --fix",
    "lint.publint": "publint",
    "lint.prettier": "prettier . --check",
    "lint.prettier:fix": "prettier . --write",
    "lint.types": "tsc --noEmit",
    "prepack": "pnpm turbo build",
    "start": "tsdown --watch",
    "test.vitest": "vitest run",
    "test.vitest:watch": "vitest watch"
  },
  "dependencies": {
    "@responsive-image/core": "workspace:^",
    "@responsive-image/build-utils": "workspace:^",
    "blurhash": "^2.0.4",
    "imagetools-core": "^10.0.0",
    "loader-utils": "^3.2.0",
    "sharp": "^0.35.0",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@responsive-image/internals": "workspace:*",
    "@tsconfig/node22": "22.0.7",
    "@types/jest-image-snapshot": "6.4.2",
    "@types/node": "22.20.7",
    "concurrently": "10.0.7",
    "css-loader": "7.1.5",
    "eslint": "10.15.0",
    "glob": "14.0.6",
    "jest-image-snapshot": "6.5.2",
    "memfs": "4.80.1",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "style-loader": "4.0.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "webpack": "5.113.0"
  },
  "peerDependencies": {
    "webpack": "^5.91.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "22.* || >= 24"
  }
}
