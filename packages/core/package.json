{
  "name": "@responsive-image/core",
  "version": "2.1.1",
  "description": "Internal core functions and config for the ResponsiveImage project",
  "keywords": [
    "responsive image",
    "responsive images"
  ],
  "repository": "github:simonihmig/responsive-image",
  "license": "MIT",
  "author": "Simon Ihmig <simon.ihmig@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./blurhash/decode": "./dist/blurhash/decode.js",
    "./blurhash/ssr": "./dist/blurhash/ssr.js",
    "./thumbhash/decode": "./dist/thumbhash/decode.js",
    "./thumbhash/ssr": "./dist/thumbhash/ssr.js"
  },
  "scripts": {
    "build": "tsdown",
    "lint:fix": "concurrently 'npm:lint.*:fix' --names 'fix:'",
    "lint.eslint": "eslint .",
    "lint.eslint:fix": "eslint . --fix",
    "lint.publint": "publint",
    "lint.prettier": "prettier . --check",
    "lint.prettier:fix": "prettier . --write",
    "lint.types": "tsc --noEmit",
    "dev": "tsdown --watch",
    "test.vitest": "vitest run",
    "test.vitest:watch": "vitest watch",
    "prepack": "pnpm turbo build"
  },
  "dependencies": {
    "base64-arraybuffer": "^1.0.2"
  },
  "peerDependencies": {
    "blurhash": "^2.0.0",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@responsive-image/internals": "workspace:*",
    "@tsconfig/strictest": "2.0.9",
    "blurhash": "2.0.5",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "thumbhash": "0.1.1",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  },
  "peerDependenciesMeta": {
    "blurhash": {
      "optional": true
    },
    "thumbhash": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
