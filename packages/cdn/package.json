{
  "name": "@responsive-image/cdn",
  "version": "2.1.0",
  "description": "Support for loading remote images from Image CDNs",
  "keywords": [
    "responsive image",
    "responsive images",
    "cdn",
    "image cdn"
  ],
  "repository": "github:simonihmig/responsive-image",
  "license": "MIT",
  "author": "Simon Ihmig <simon.ihmig@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "lint:fix": "concurrently 'npm:lint.*:fix' --names 'fix:'",
    "lint.eslint": "eslint .",
    "lint.eslint:fix": "eslint . --fix",
    "lint.publint": "publint",
    "lint.prettier": "prettier . --check",
    "lint.prettier:fix": "prettier . --write",
    "lint.types": "tsc --noEmit",
    "start": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prepack": "pnpm turbo build"
  },
  "dependencies": {
    "@responsive-image/core": "workspace:^"
  },
  "devDependencies": {
    "@responsive-image/internals": "workspace:*",
    "@tsconfig/strictest": "2.0.9",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
