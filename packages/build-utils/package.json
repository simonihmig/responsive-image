{
  "name": "@responsive-image/build-utils",
  "version": "3.0.1",
  "description": "Internal package for shared build-related code as part of the ResponsiveImage project",
  "keywords": [
    "responsive image",
    "responsive images"
  ],
  "repository": "github:simonihmig/responsive-image",
  "license": "MIT",
  "author": "Simon Ihmig <simon.ihmig@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:fix": "concurrently 'npm:lint.*:fix' --names 'fix:'",
    "lint.eslint": "eslint .",
    "lint.eslint:fix": "eslint . --fix",
    "lint.publint": "publint",
    "lint.prettier": "prettier . --check",
    "lint.prettier:fix": "prettier . --write",
    "lint.types": "tsc --noEmit",
    "prepack": "pnpm turbo build",
    "start": "tsdown --watch",
    "test.vitest": "vitest run",
    "test.vitest:watch": "vitest watch"
  },
  "dependencies": {
    "@responsive-image/core": "workspace:^",
    "@rollup/pluginutils": "^5.1.0",
    "base-n": "^3.0.0",
    "imagetools-core": "^12.0.0",
    "javascript-stringify": "^2.1.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@responsive-image/internals": "workspace:*",
    "@tsconfig/node22": "22.0.7",
    "@types/jest-image-snapshot": "6.4.2",
    "@types/node": "22.20.5",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "glob": "14.0.6",
    "jest-image-snapshot": "6.5.2",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "rollup": "4.68.8",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "22.* || >= 24"
  }
}
